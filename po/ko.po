#, python-brace-format
msgid "Special files in archives are not supported: {path}"
msgstr "압축 파일의 특수 파일은 지원되지 않습니다: {path}"

#: daemon/archivejob.cpp
#, python-brace-format
msgid "Could not create the parent folder for {path}"
msgstr "상위 폴더를 생성할 수 없습니다: {path}"

#: daemon/archivejob.cpp
#, python-brace-format
msgid "Could not write {path}: {error}"
msgstr "쓸 수 없습니다: {path}: {error}"

#: daemon/archivejob.cpp
#, python-brace-format
msgid "Symbolic link parent in archive: {path}"
msgstr "압축 파일에 심볼릭 링크인 상위 폴더가 있습니다: {path}"

