msgid "Could not create a temporary extraction folder"
msgstr "임시 압축 해제 폴더를 생성할 수 없습니다"

#: daemon/archivejob.cpp
#, python-brace-format
msgid "Unsafe path in archive: {path}"
msgstr "압축 파일에 안전하지 않은 경로가 있습니다: {path}"

#: daemon/archivejob.cpp
#, python-brace-format
msgid "Hard links in archives are not supported: {path}"
msgstr "압축 파일의 하드 링크는 지원되지 않습니다: {path}"

#: daemon/archivejob.cpp
#, python-brace-format
msgid "Invalid symbolic link path in archive: {path}"
msgstr "압축 파일에 잘못된 심볼릭 링크 경로가 있습니다: {path}"

#: daemon/archivejob.cpp
#, python-brace-format
msgid "Invalid symbolic link target: {path}"
msgstr "잘못된 심볼릭 링크 대상: {path}"

