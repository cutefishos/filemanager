#: daemon/archivejob.cpp
#, python-brace-format
msgid "Could not restore symbolic link: {path}"
msgstr "심볼릭 링크를 복원할 수 없습니다: {path}"

#: daemon/fileoperationsservice.cpp
msgid "The task could not be published"
msgstr "작업을 게시할 수 없습니다"

#: mountd/apfs.cpp mountd/hfsplus.cpp
msgid "The volume in the disk image is damaged."
msgstr "디스크 이미지의 볼륨이 손상되었습니다."

#: mountd/apfs.cpp mountd/diskimagebackend.cpp
msgid "The disk image holds no volume that can be opened."
msgstr "디스크 이미지에 열 수 있는 볼륨이 없습니다."

#: mountd/apfs.cpp mountd/diskimage.cpp
msgid "Encrypted disk images cannot be opened."
msgstr "암호화된 디스크 이미지는 열 수 없습니다."

