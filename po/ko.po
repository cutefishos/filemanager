#: daemon/archivejob.cpp
msgid "Unknown ZIP error"
msgstr "알 수 없는 ZIP 오류"

#: daemon/archivejob.cpp
msgid "Password-protected RAR archives are not supported"
msgstr "암호로 보호된 RAR 압축 파일은 지원되지 않습니다"

#: daemon/archivejob.cpp
msgid "Password-protected 7z archives are not supported"
msgstr "암호로 보호된 7z 압축 파일은 지원되지 않습니다"

#: daemon/archivejob.cpp
msgid "This kind of ZIP encryption is not supported"
msgstr "이 종류의 ZIP 암호화는 지원되지 않습니다"

#: daemon/archivejob.cpp
msgid "Password-protected archives of this format are not supported"
msgstr "이 형식의 암호로 보호된 압축 파일은 지원되지 않습니다"

#: daemon/archivejob.cpp
msgid "Unknown archive error"
msgstr "알 수 없는 압축 파일 오류"

#: daemon/archivejob.cpp
msgid "Could not allocate memory for the archive"
msgstr "압축 파일을 위한 메모리를 할당할 수 없습니다"

