msgid "Disk images split into several files cannot be opened."
msgstr "여러 파일로 분할된 디스크 이미지는 열 수 없습니다."

#: mountd/diskimage.cpp
msgid "The disk image is damaged."
msgstr "디스크 이미지가 손상되었습니다."

#: mountd/diskimage.cpp
msgid "The disk image uses a compression that cannot be read."
msgstr "디스크 이미지가 읽을 수 없는 압축 방식을 사용합니다."

#: mountd/fusemount.cpp
#, python-brace-format
msgid "Cannot create {path}"
msgstr "생성할 수 없습니다: {path}"

#: mountd/fusemount.cpp
msgid "Cannot start the FUSE session"
msgstr "FUSE 세션을 시작할 수 없습니다"

#: mountd/fusemount.cpp
#, python-brace-format
msgid "Cannot mount {path}"
msgstr "마운트할 수 없습니다: {path}"

#: mountd/mountservice.cpp
#, python-brace-format
msgid "“{path}” is not an absolute path."
msgstr "절대 경로가 아닙니다: “{path}”"

#: mountd/mountservice.cpp
#, python-brace-format
msgid "“{location}” is not a location that can be connected to."
msgstr "“{location}” 위치에는 연결할 수 없습니다."

#: mountd/mountservice.cpp
#, python-brace-format
msgid "Already connecting to “{location}”."
msgstr "이미 “{location}”에 연결하는 중입니다."

#: mountd/mtpbackend.cpp
msgid "The device could not be opened. Unplug it and connect it again."
msgstr "장치를 열 수 없습니다. 장치를 분리했다가 다시 연결하십시오."

#: mountd/mtpbackend.cpp
msgid "The device's files are not available. Unlock it and allow access to its data on its screen; if that does not help, choose file transfer in its USB settings."
msgstr "장치의 파일을 사용할 수 없습니다. 장치의 잠금을 해제하고 화면에서 데이터 접근을 허용하십시오. 그래도 안 되면 장치의 USB 설정에서 파일 전송을 선택하십시오."

#: mountd/sftpbackend.cpp
msgid "Cannot start an SSH session"
msgstr "SSH 세션을 시작할 수 없습니다"

#: mountd/smbbackend.cpp
msgid "The share does not exist."
msgstr "공유 폴더가 존재하지 않습니다."

#: mountd/smbbackend.cpp
msgid "The server could not be reached."
msgstr "서버에 연결할 수 없습니다."

