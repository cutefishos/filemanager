msgid "The first part of this multi-part archive is missing"
msgstr "이 분할 압축 파일의 첫 번째 부분이 없습니다"

#: daemon/archivejob.cpp
#, python-brace-format
msgid "The source no longer exists: {path}"
msgstr "원본이 더 이상 존재하지 않습니다: {path}"

#: daemon/archivejob.cpp
#, python-brace-format
msgid "Could not read symbolic link: {path}"
msgstr "심볼릭 링크를 읽을 수 없습니다: {path}"

#: daemon/archivejob.cpp
#, python-brace-format
msgid "The source is not a regular file: {path}"
msgstr "원본이 일반 파일이 아닙니다: {path}"

#: daemon/archivejob.cpp
msgid "No files were selected"
msgstr "선택한 파일이 없습니다"

#: daemon/archivejob.cpp
#, python-brace-format
msgid "The destination folder does not exist: {path}"
msgstr "대상 폴더가 존재하지 않습니다: {path}"

#: daemon/archivejob.cpp
msgid "Could not allocate memory for symbolic link"
msgstr "심볼릭 링크를 위한 메모리를 할당할 수 없습니다"

#: daemon/archivejob.cpp
#, python-brace-format
msgid "Could not create {path}"
msgstr "생성할 수 없습니다: {path}"

